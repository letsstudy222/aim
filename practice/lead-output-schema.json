{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "category": {
      "type": "string",
      "enum": [
        "sales",
        "support",
        "other"
      ]
    },
    "reason": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    },
    "needs_review": {
      "type": "boolean"
    },
    "evidence": {
      "type": "string",
      "minLength": 1,
      "maxLength": 300
    }
  },
  "required": [
    "category",
    "reason",
    "needs_review",
    "evidence"
  ],
  "additionalProperties": false
}
